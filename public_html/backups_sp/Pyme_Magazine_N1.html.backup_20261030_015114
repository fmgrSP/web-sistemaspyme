  <meta charset="UTF-8">
  <title>Pyme Magazine Nº 1: La Nueva Regla del Boca a Boca — Sistemas Pyme</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/qr-code-styling@1.6.0-rc.1/lib/qr-code-styling.js"></script>
  
  <style>
    :root {
      --folder-navy: #0a2246;
      --folder-dark: #07162e;
      --primary: #0b2545;
      --primary-dark: #06101e;
      --accent: #0f766e;
      --accent-light: #ccfbf1;
      --neon-green: #00d896;
      --circuit-cyan: #19b5fe;
      --accent-bright: #2dd4bf;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --bg-light: #f8fafc;
      --gold: #d97706;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    
    @page {
      size: A4 portrait;
      margin: 0;
    }

    html, body {
      width: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: #334155;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 22px;
      padding: 22px 0;
    }

    /* FORMATO FOLIO A4 EXACTO EN ESCRITORIO E IMPRESIÓN */
    .page {
      width: 210mm;
      height: 297mm;
      min-height: 297mm;
      max-height: 297mm;
      background: white;
      position: relative;
      overflow: hidden;
      box-shadow: 0 12px 35px rgba(0,0,0,0.35);
      page-break-after: always;
      page-break-inside: avoid;
      display: flex;
      flex-direction: column;
    }

    @media print {
      body { background: white !important; padding: 0 !important; gap: 0 !important; margin: 0 !important; }
      .page { 
        width: 210mm !important;
        height: 297mm !important; 
        min-height: 297mm !important;
        max-height: 297mm !important;
        box-shadow: none !important; 
        margin: 0 !important; 
        border-radius: 0 !important;
        overflow: hidden !important; 
      }
      .no-print, .mobile-end-back-wrap { display: none !important; }
      .dark-page { background-color: var(--folder-dark) !important; color: white !important; }
    }

    /* BARRA DE IMPRESIÓN Y CONTROL (SOLO ESCRITORIO) */
    .print-bar {
      background: #0f172a;
      color: white;
      padding: 10px 22px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      font-size: 13px;
      position: sticky;
      top: 12px;
      z-index: 100;
      box-shadow: 0 10px 25px rgba(0,0,0,0.45);
      border: 1px solid rgba(255,255,255,0.14);
      max-width: 96vw;
    }
    .print-bar-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }
    .print-btn {
      background: var(--accent);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 999px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      text-decoration: none;
      font-size: 12.5px;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .print-btn:hover { background: #115e59; }
    .back-btn {
      background: #1e293b;
      border: 1px solid rgba(45, 212, 191, 0.45);
    }
    .back-btn:hover {
      background: #334155;
    }

    /* BOTÓN DE RETORNO AL FINAL DEL ARTÍCULO (OCULTO EN PC, VISIBLE EN MÓVIL AL TERMINAR DE LEER) */
    .mobile-end-back-wrap {
      display: none;
    }

    /* TIPOGRAFÍAS Y ESTILOS EDITORIALES CALIBRADOS PARA LECTURA AMPLIA EN PANTALLA E IMPRESIÓN A4 */
    h1, h2, h3.serif { font-family: 'Playfair Display', serif; color: var(--primary); }
    p {
      font-size: 9.75pt;
      line-height: 1.49;
      color: var(--text-main);
      margin-bottom: 8.5pt;
      text-align: left;
    }
    
    .header-tag {
      font-size: 8.5pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--accent);
      margin-bottom: 4px;
      display: block;
    }

    /* CABECERA CORPORATIVA SOBRIA, LIMPIA Y DE ALTA LEGIBILIDAD (84mm) */
    .cover-header-folder {
      height: 84mm;
      position: relative;
      background-color: var(--folder-dark);
      background-image:
        radial-gradient(circle at 82% 28%, rgba(0, 216, 150, 0.25) 0%, rgba(25, 181, 254, 0.14) 35%, rgba(7, 22, 46, 0) 70%),
        radial-gradient(circle at 18% 88%, rgba(15, 118, 110, 0.28) 0%, rgba(7, 22, 46, 0) 58%),
        radial-gradient(circle at 52% 10%, rgba(25, 181, 254, 0.12) 0%, rgba(7, 22, 46, 0) 50%),
        linear-gradient(135deg, #040d1c 0%, #0a2246 52%, #0b3d4c 100%);
      padding: 18px 36px 22px 36px;
      color: white;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-bottom: 3.5px solid var(--neon-green);
    }

    /* FONDO VECTORIAL SUTIL DE CIRCUITERÍA CORPORATIVA (CERO RUIDO VISUAL) */
    .cover-circuit-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }
    
    /* Control de visibilidad del SVG de fondo (Escritorio vs Móvil) */
    .circuit-mobile { display: none; }

    /* FILA SUPERIOR DENTRO DEL HEADER: LOGO OFICIAL EN CÁPSULA + ETIQUETA REVISTA */
    .cover-top-bar {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      padding-bottom: 12px;
    }
    .folder-brand-lockup {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }
    .brand-logo-pill {
      background: #ffffff;
      border-radius: 999px;
      padding: 5px 15px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35), 0 0 0 1.5px rgba(0, 216, 150, 0.35);
    }
    .sp-main-logo-img {
      height: 36px;
      width: auto;
      max-width: 195px;
      display: block;
      object-fit: contain;
    }

    .magazine-issue-meta {
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 3px;
    }
    .masthead-badge {
      background: rgba(6, 22, 46, 0.85);
      border: 1.5px solid var(--neon-green);
      color: #ffffff;
      padding: 3px 11px;
      border-radius: 999px;
      font-weight: 900;
      letter-spacing: 1.5px;
      font-size: 7.5pt;
      text-transform: uppercase;
    }
    .masthead-sub {
      font-size: 6.8pt;
      color: #7dd3fc;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
    }

    /* FILA INFERIOR DENTRO DEL HEADER: TITULAR + CÁPSULA QR ESTILO CARPETA */
    .cover-bottom-row {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 24px;
      margin-top: auto;
    }
    .cover-hero-content {
      max-width: 66%;
    }
    .cover-title {
      font-size: 29pt;
      line-height: 1.07;
      margin-bottom: 8px;
      color: white;
      font-weight: 800;
      text-shadow: 0 4px 16px rgba(0,0,0,0.65);
    }
    .cover-subtitle {
      font-family: 'Inter', sans-serif;
      font-size: 10pt;
      font-weight: 400;
      color: #f1f5f9;
      line-height: 1.44;
      margin-bottom: 0;
      text-shadow: 0 2px 8px rgba(0,0,0,0.65);
    }

    /* CÁPSULA DE PODCAST CON EL MARCO VERDE NEÓN / CIAN DE LA CARPETA */
    .podcast-cover-badge {
      background: rgba(7, 22, 46, 0.88);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1.5px solid var(--neon-green);
      border-radius: 10px;
      padding: 9px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      width: 226px;
      flex-shrink: 0;
      box-shadow: 0 8px 22px rgba(0,0,0,0.55);
      text-decoration: none;
    }
    .podcast-cover-badge img {
      width: 50px;
      height: 50px;
      border-radius: 6px;
      background: white;
      padding: 3px;
      flex-shrink: 0;
    }
    .podcast-cover-text {
      font-size: 6.9pt;
      line-height: 1.26;
      color: #e2e8f0;
    }
    .podcast-cover-text strong {
      color: var(--neon-green);
      display: block;
      font-size: 7.4pt;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      line-height: 1.2;
      margin-bottom: 3px;
    }
    .podcast-cover-text strong .audio-duracion {
      display: block;
      font-size: 6.8pt;
      color: #7dd3fc;
      white-space: nowrap;
      margin-top: 1px;
    }

    /* CINTA CABECERA PARA PÁGINAS INTERIORES (2, 3 y 4) CON CIRCUITOS DE LA CARPETA */
    .inner-page-strip {
      height: 14mm;
      background-color: var(--folder-navy);
      padding: 0 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      overflow: hidden;
      border-bottom: 2.5px solid var(--neon-green);
      flex-shrink: 0;
    }
    .inner-strip-wave {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .inner-strip-left {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .inner-strip-title {
      color: #ffffff;
      font-size: 8pt;
      font-weight: 800;
      letter-spacing: 0.5px;
    }
    .inner-strip-title em {
      color: var(--neon-green);
      font-style: normal;
      font-weight: 900;
    }
    .inner-strip-right {
      position: relative;
      z-index: 2;
      color: #7dd3fc;
      font-size: 7.5pt;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .content-area {
      padding: 16px 36px 12px 36px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .two-columns {
      column-count: 2;
      column-gap: 24px;
    }
    
    .drop-cap::first-letter {
      float: left;
      font-size: 38pt;
      line-height: 32pt;
      padding-top: 2px;
      padding-right: 8px;
      padding-left: 2px;
      font-family: 'Playfair Display', serif;
      color: var(--accent);
      font-weight: 800;
    }

    .scenario-box {
      background: var(--bg-light);
      border: 1px solid #e2e8f0;
      border-left: 4px solid var(--accent);
      border-radius: 0 8px 8px 0;
      padding: 8.5px 12px;
      margin-bottom: 8.5px;
      break-inside: avoid;
    }
    .scenario-box h3 {
      font-family: 'Inter', sans-serif;
      font-size: 9.1pt;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 2.5px;
    }
    .scenario-box p {
      margin-bottom: 0;
      font-size: 8.75pt;
      line-height: 1.38;
    }

    /* PÁGINA 2: PÁGINA OSCURA CON LAS ONDAS DE CIRCUITO DE LA CARPETA */
    .dark-page {
      background-color: var(--folder-dark);
      color: white;
    }
    .dark-page .content-area {
      padding: 24px 36px 16px 36px;
      position: relative;
      z-index: 2;
    }
    .dark-page h2 {
      color: white;
      font-size: 22pt;
      line-height: 1.15;
      margin-bottom: 14px;
    }
    .dark-page p {
      color: #cbd5e1;
      font-size: 9.85pt;
      line-height: 1.52;
    }
    
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin: 12px 0 16px 0;
    }
    .stat-card {
      background: rgba(15, 118, 110, 0.14);
      border: 1.5px solid rgba(45, 212, 191, 0.38);
      padding: 12px 11px;
      border-radius: 10px;
      text-align: center;
    }
    .stat-num {
      font-family: 'Playfair Display', serif;
      font-size: 25pt;
      font-weight: 800;
      color: var(--accent-bright);
      line-height: 1.1;
      margin-bottom: 4px;
    }
    .stat-text {
      font-size: 7.5pt;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #f1f5f9 !important;
      font-weight: 600;
      line-height: 1.25;
    }

    .Seo-warning-card {
      background: rgba(245, 158, 11, 0.1);
      border: 1.5px solid rgba(245, 158, 11, 0.45);
      border-radius: 10px;
      padding: 14px 18px;
      margin-top: auto;
      break-inside: avoid;
    }
    .Seo-warning-card h4 {
      color: #fbbf24;
      font-size: 9.9pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 5px;
    }
    .Seo-warning-card p {
      font-size: 9.15pt;
      color: #f8fafc;
      margin-bottom: 0;
      line-height: 1.44;
    }

    /* PÁGINAS 3 Y 4 */
    .section-title {
      font-size: 19.5pt;
      line-height: 1.14;
      margin-bottom: 10px;
    }

    .shield-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 9.5px;
      margin: 6px 0 11px 0;
    }
    .shield-card {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-top: 3px solid var(--accent);
      border-radius: 8px;
      padding: 9.5px 12px;
    }
    .shield-card h4 {
      font-size: 9.1pt;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 3.5px;
    }
    .shield-card p {
      font-size: 8.35pt;
      line-height: 1.36;
      margin-bottom: 0;
      color: #334155;
    }

    .highlight-quote {
      font-family: 'Playfair Display', serif;
      font-size: 11.8pt;
      font-style: italic;
      color: var(--primary);
      background: #f0fdfa;
      border-left: 4px solid var(--accent);
      padding: 11px 16px;
      border-radius: 0 8px 8px 0;
      margin-top: auto;
      line-height: 1.36;
    }

    /* PÁGINA 4: INFOGRAFÍA DEL ECOSISTEMA + FOTO DEL ATRIL */
    .visual-showcase {
      width: 100%;
      height: 168px;
      margin: 2px 0 11px 0;
      border-radius: 10px;
      overflow: hidden;
      background: linear-gradient(135deg, #06101e 0%, #0b2545 55%, #0f766e 100%);
      position: relative;
      border: 1.5px solid #cbd5e1;
    }
    .visual-showcase img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .pillar-step {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-left: 4px solid var(--accent);
      border-radius: 6px;
      padding: 8.5px 12px;
      margin-bottom: 8px;
      break-inside: avoid;
    }
    .pillar-step strong {
      display: block;
      font-size: 9.2pt;
      color: var(--primary);
      margin-bottom: 2.5px;
    }
    .pillar-step p {
      font-size: 8.65pt;
      line-height: 1.37;
      margin-bottom: 0;
    }

    /* CAJA DE CIERRE PÁGINA 4 INSPIRADA EN LA CONTRAPORTADA DE TU CARPETA */
    .action-box {
      background: linear-gradient(135deg, #06101e 0%, #0b2545 60%, #0f766e 100%);
      color: white;
      padding: 14px 18px;
      border-radius: 12px;
      margin-top: auto;
      display: flex;
      align-items: center;
      gap: 16px;
      position: relative;
      overflow: hidden;
      border: 1.5px solid rgba(45, 212, 191, 0.45);
    }
    .action-box h3 {
      font-family: 'Playfair Display', serif;
      color: white;
      font-size: 13.5pt;
      margin-bottom: 4px;
    }
    .action-box p {
      color: #e2e8f0;
      margin-bottom: 0;
      font-size: 8.75pt;
      line-height: 1.38;
    }
    
    .qr-folder-box {
      background: #081c3a;
      border: 1.5px solid var(--accent-bright);
      padding: 7px 9px;
      border-radius: 10px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .qr-folder-top {
      color: #ffffff;
      font-size: 6.3pt;
      font-weight: 900;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .qr-folder-box img {
      width: 76px;
      height: 76px;
      display: block;
      background: #081c3a;
      padding: 3px;
      border-radius: 6px;
    }
    .qr-folder-bottom {
      color: #7dd3fc !important;
      font-size: 6.6pt;
      font-weight: 800;
      margin-top: 4px;
      letter-spacing: 0.4px;
    }

    .footer {
      margin-top: auto;
      padding: 9px 36px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 8pt;
      color: var(--text-muted);
      position: relative;
      z-index: 2;
    }
    .dark-page .footer {
      border-top-color: rgba(45, 212, 191, 0.2);
      color: #94a3b8;
    }
    .footer-logo {
      font-weight: 800;
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .dark-page .footer-logo {
      color: white;
    }
    .footer-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent-bright);
      display: inline-block;
    }

    /* ========================================================================= */
    /* TIPOGRAFÍA ESTILO PRENSA DIGITAL MODERNA EN PANTALLA (+1.5 A +2 PUNTOS)   */
    /* ========================================================================= */
    @media screen {
      .page {
        height: auto;
        min-height: 297mm;
        max-height: none;
      }
      p {
        font-size: 11.4pt;
        line-height: 1.58;
        margin-bottom: 10pt;
      }
      .dark-page p {
        font-size: 11.4pt;
        line-height: 1.58;
      }
      .cover-subtitle {
        font-size: 11.2pt;
        line-height: 1.48;
      }
      .scenario-box {
        padding: 10px 14px;
        margin-bottom: 10px;
      }
      .scenario-box h3 {
        font-size: 10.6pt;
        margin-bottom: 4px;
      }
      .scenario-box p {
        font-size: 10.3pt;
        line-height: 1.46;
      }
      .stat-num {
        font-size: 27pt;
      }
      .stat-text {
        font-size: 8.8pt;
        line-height: 1.32;
      }
      .Seo-warning-card h4 {
        font-size: 11.2pt;
        margin-bottom: 6px;
      }
      .Seo-warning-card p {
        font-size: 10.5pt;
        line-height: 1.5;
      }
      .shield-card {
        padding: 11px 14px;
        margin-bottom: 5px;
      }
      .shield-card h4 {
        font-size: 10.6pt;
        margin-bottom: 5px;
      }
      .shield-card p {
        font-size: 9.9pt;
        line-height: 1.46;
      }
      .highlight-quote {
        font-size: 13pt;
        line-height: 1.44;
      }
      .pillar-step {
        padding: 10px 14px;
        margin-bottom: 10px;
      }
      .pillar-step strong {
        font-size: 10.8pt;
        margin-bottom: 4px;
      }
      .pillar-step p {
        font-size: 10.2pt;
        line-height: 1.46;
      }
      .action-box h3 {
        font-size: 15pt;
      }
      .action-box p {
        font-size: 10.2pt;
        line-height: 1.46;
      }
      .podcast-cover-text {
        font-size: 7.8pt;
      }
      .podcast-cover-text strong {
        font-size: 8.4pt;
      }
      .footer {
        font-size: 9pt;
      }
    }

    /* ========================================================================= */
    /* MODO AUTOENCUADRANTE MÓVIL: PORTADA LIMPIA + VOLVER SOLO AL FINAL DEL TODO */
    /* ========================================================================= */
    @media screen and (max-width: 840px) {
      body {
        padding: 6px 8px 28px 8px;
        gap: 16px;
        background-color: #0f172a;
      }

      /* Intercambio de SVG en móvil para mostrar el lado izquierdo limpio */
