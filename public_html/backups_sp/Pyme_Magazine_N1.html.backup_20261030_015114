    function renderizarQrCorporativoSP(imgEl) {
      if (!imgEl || imgEl.dataset.qrRendered === "1") return;
      imgEl.dataset.qrRendered = "1";
      const url = imgEl.getAttribute("data-qr-url") || "https://sistemaspyme.es";
      const theme = imgEl.getAttribute("data-qr-theme") || "light";
      const esOscuro = theme === "dark";

      if (typeof QRCodeStyling === "undefined") {
        imgEl.src = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&color=0d7d74&data=" + encodeURIComponent(url);
        return;
      }

      const qr = new QRCodeStyling({
        width: 320,
        height: 320,
        type: "canvas",
        data: url,
        margin: 6,
        qrOptions: { errorCorrectionLevel: "H" },
        image: esOscuro ? SVG_LOGO_SP_BLANCO : SVG_LOGO_SP_OSCURO,
        dotsOptions: {
          type: "classy-rounded",
          gradient: {
            type: "linear",
            rotation: Math.PI / 4,
            colorStops: esOscuro
              ? [{ offset: 0, color: "#00d896" }, { offset: 1, color: "#14b8a6" }]
              : [{ offset: 0, color: "#00c48c" }, { offset: 1, color: "#0b6460" }]
          }
        },
        cornersSquareOptions: {
          type: "extra-rounded",
          color: esOscuro ? "#14b8a6" : "#00b383"
        },
        cornersDotOptions: {
          type: "dot",
          color: esOscuro ? "#00d896" : "#0b6460"
        },
        backgroundOptions: {
          color: esOscuro ? "#081c3a" : "#ffffff"
        },
        imageOptions: {
          crossOrigin: "anonymous",
          margin: 5,
          imageSize: 0.36
        }
      });

      if (esOscuro) {
        imgEl.style.background = "#081c3a";
        imgEl.style.padding = "3px";
      }

      qr.getRawData("png").then((blob) => {
        if (blob) imgEl.src = URL.createObjectURL(blob);
      }).catch(() => {
        imgEl.src = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&color=0d7d74&data=" + encodeURIComponent(url);
      });
    }

    window.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("img[data-qr-url]").forEach((img) => {
        renderizarQrCorporativoSP(img);
      });
