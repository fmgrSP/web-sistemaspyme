<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>5/9 • Tarifas Fase 1 Oficial 59€ (A5) - Sistemas Pyme</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/qr-code-styling@1.6.0-rc.1/lib/qr-code-styling.js"></script>
  <style id="dynamic-page-size">@page { size: A5 portrait; margin: 0; }</style>
<style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    :root {
      --primary: #0b2545;
      --primary-dark: #071930;
      --logo-blue: #104070;
      --teal: #0d7d74;
      --teal-dark: #095852;
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      
      /* Planes */
      --plan-base: #64748b;
      --plan-duo: #2563eb;
      --plan-trinity: #16a34a;
      --plan-quatro: #4338ca;
      --plan-pentium: #0f766e;
      --plan-sixtina: #0284c7;
      --plan-pleyades: #d97706;
      --plan-octoplus: #0891b2;
      --plan-novaria: #e11d48;
      --plan-deca: #6d28d9;
      
      /* Satélites y Categorías */
      --insta-pink: #be185d;
      --track-blue: #0369a1;
      --b2b-purple: #6d28d9;
      --audit-gold: #b45309;
      --audit-bg: #fffbeb;
      --cat-reputacion: #0f766e; 
      --cat-facturacion: #1e3a8a; 
      --cat-eficiencia: #4338ca; 
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #0f172a;
      color: #0f172a;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 14px 0 40px 0;
    }

    /* BARRA DE GESTIÓN, NAVEGACIÓN Y DESCARGA INDIVIDUAL */
    .suite-toolbar {
      background: #1e293b;
      color: #ffffff;
      padding: 10px 16px;
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 96%;
      max-width: 1120px;
      box-shadow: 0 10px 28px rgba(0,0,0,0.6);
      border: 1px solid #334155;
      position: sticky;
      top: 8px;
      z-index: 100;
    }
    .toolbar-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      border-bottom: 1px solid #334155;
      padding-bottom: 8px;
    }
    .toolbar-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 800;
      color: #f8fafc;
    }
    .toolbar-badge {
      background: #0d7d74;
      color: #ffffff;
      font-size: 10.5px;
      padding: 2px 8px;
      border-radius: 999px;
      font-weight: 700;
    }
    .toolbar-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .action-btn {
      border: none;
      padding: 7px 14px;
      border-radius: 9999px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      transition: all 0.2s;
    }
    .btn-download-html {
      background: #0ea5e9;
      color: #0f172a;
    }
    .btn-download-html:hover { background: #38bdf8; }
    .btn-print-pdf {
      background: #f59e0b;
      color: #0f172a;
    }
    .btn-print-pdf:hover { background: #fbbf24; }

    .tabs-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    .tab-btn {
      background: #0f172a;
      color: #cbd5e1;
      border: 1px solid #334155;
      padding: 5.5px 11px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 11px;
      cursor: pointer;
      transition: all 0.18s;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .tab-btn:hover {
      color: #ffffff;
      border-color: #64748b;
    }
    .tab-btn.active {
      background: #0d7d74;
      color: #ffffff;
      border-color: #14b8a6;
      box-shadow: 0 0 12px rgba(20, 184, 166, 0.35);
    }
    .tab-format {
      font-size: 9px;
      font-weight: 800;
      padding: 1px 4px;
      border-radius: 4px;
      background: rgba(255,255,255,0.15);
      color: #e2e8f0;
    }

    .tarjeton-group {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }
    .tarjeton-group.active {
      display: flex;
    }

    /* HOJA A5 EXACTA */
    .sheet {
      width: 148mm;
      height: 210mm;
      min-height: 210mm;
      max-height: 210mm;
      background: #ffffff;
      padding: 4.5mm 7.8mm 4mm 7.8mm;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45);
      page-break-after: always;
      page-break-inside: avoid;
    }

    /* HOJA A4 EXACTA (PARA EL DOSSIER DE 4 PÁGINAS) */
    .sheet-a4 {
      width: 210mm;
      height: 297mm;
      min-height: 297mm;
      max-height: 297mm;
      background: #ffffff;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.45);
      page-break-after: always;
      page-break-inside: avoid;
    }

    @media print {
      body {
        background: none;
        padding: 0;
        gap: 0;
      }
      .no-print {
        display: none !important;
      }
      .tarjeton-group {
        display: none !important;
      }
      .tarjeton-group.active {
        display: block !important;
      }
      .sheet {
        box-shadow: none;
        page-break-after: always;
        height: 210mm !important;
        max-height: 210mm !important;
        margin: 0 !important;
      }
      .sheet-a4 {
        box-shadow: none;
        page-break-after: always;
        width: 210mm !important;
        height: 297mm !important;
        min-height: 297mm !important;
        max-height: 297mm !important;
        margin: 0 !important;
      }
    }

    /* CABECERA COMÚN */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--primary);
      padding-bottom: 2px;
      margin-bottom: 2px;
    }
    .brand-logo-img {
      max-height: 44px;
      width: auto;
      max-width: 84mm;
      object-fit: contain;
      display: block;
    }
    .header-tagline {
      text-align: right;
      font-size: 7px;
      color: var(--slate-600);
      font-weight: 600;
      line-height: 1.22;
    }
    .header-tagline strong {
      color: var(--teal-dark);
      font-size: 7.8px;
      display: block;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    /* BANNERS DE SECCIÓN */
    .section-banner {
      background: var(--primary);
      color: white;
      padding: 3.5px 8px;
      border-radius: 4.5px;
      font-size: 8.6px;
      font-weight: 800;
      letter-spacing: 0.2px;
      text-transform: uppercase;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 6px;
      margin-bottom: 3.5px;
    }
    .section-banner.green { background: linear-gradient(90deg, #095852 0%, #0d7d74 100%); }
    .section-banner.purple { background: linear-gradient(90deg, #312e81 0%, #4338ca 100%); }
    .section-banner.gold { background: linear-gradient(90deg, #78350f 0%, #d97706 100%); }
    .section-banner.reputacion { background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%); }
    .section-banner.facturacion { background: linear-gradient(90deg, #172554 0%, #1e3a8a 100%); }
    .section-banner.eficiencia { background: linear-gradient(90deg, #3730a3 0%, #4f46e5 100%); }
    .section-banner.insta { background: linear-gradient(90deg, #831843 0%, #db2777 100%); }

    .section-banner .rule {
      font-size: 7.2px;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.22);
      padding: 1px 5.5px;
      border-radius: 3px;
      text-align: right;
      text-transform: none;
    }

    /* TABLAS DE PRECIOS (TARIFAS FASE 2) */
    .price-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 2.5px;
      font-size: 8px;
    }
    .price-table th {
      background: #e2e8f0;
      color: var(--primary);
      font-weight: 800;
      text-transform: uppercase;
      font-size: 7px;
      padding: 2.6px 5px;
      border-top: 1px solid #cbd5e1;
      border-bottom: 1.2px solid #cbd5e1;
      text-align: left;
    }
    .price-table td {
      padding: 2.4px 5px;
      border-bottom: 1px solid var(--slate-200);
      color: var(--slate-800);
      vertical-align: middle;
      line-height: 1.16;
    }
    .price-table tr.row-star { background: #f0fdf4; }
    .price-table tr.row-star td {
      border-top: 1.2px solid #86efac !important;
      border-bottom: 1.2px solid #86efac !important;
      font-weight: 600;
    }
    .price-table tr.row-corp { background: #ecfeff; }
    .price-table tr.row-corp td {
      border-top: 1.2px solid #67e8f9 !important;
      border-bottom: 1.2px solid #67e8f9 !important;
      font-weight: 600;
    }
    .price-table tr.row-suite { background: #faf5ff; }
    .price-table tr.row-suite td {
      border-top: 1.2px solid #c4b5fd !important;
      border-bottom: 1.2px solid #c4b5fd !important;
      font-weight: 600;
    }

    .pack-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .pack-name {
      font-weight: 900;
      font-size: 8.6px;
      line-height: 1.1;
      color: var(--primary);
    }
    .pack-subtext {
      font-size: 6.2px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.2px;
    }
    .price-badge {
      font-size: 9.5px;
      font-weight: 900;
      color: var(--teal-dark);
      white-space: nowrap;
    }
    .price-badge.insta { color: var(--insta-pink); }
    .price-badge.track { color: var(--track-blue); }
    .price-badge.b2b { color: var(--b2b-purple); }
    .price-badge.audit { color: var(--teal-dark); }

    .save-pill {
      font-size: 6.4px;
      font-weight: 800;
      color: #15803d;
      background: #dcfce7;
      border: 1px solid #86efac;
      padding: 0.5px 3.5px;
      border-radius: 3px;
      display: inline-block;
      white-space: nowrap;
      font-style: normal;
    }

    /* CAJA DE AUDITORÍA PREMIUM SEO + GEO (EN COLOR VERDE CORPORATIVO) */
    .audit-hero-box {
      background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 100%);
      border: 1.4px solid #5eead4;
      border-left: 4px solid var(--teal);
      border-radius: 4.5px;
      padding: 4px 7px;
      margin-bottom: 2.5px;
    }
    .audit-hero-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2px;
    }
    .audit-hero-title {
      font-size: 8.5px;
      font-weight: 900;
      color: var(--teal-dark);
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .audit-tag-pill {
      font-size: 6.2px;
      font-weight: 800;
      background: var(--teal-dark);
      color: #ffffff;
      padding: 1px 5px;
      border-radius: 3px;
      text-transform: uppercase;
      letter-spacing: 0.2px;
    }
    .audit-options-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4.5px;
      margin-top: 2.5px;
    }
    .audit-opt-card {
      background: #ffffff;
      border: 1px solid #99f6e4;
      border-radius: 3.5px;
      padding: 2.8px 5px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .audit-opt-card.featured {
      background: #f0fdf4;
      border: 1.3px solid #16a34a;
    }
    .audit-opt-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1px;
    }
    .audit-opt-name {
      font-size: 7px;
      font-weight: 800;
      color: var(--primary);
    }
    .audit-opt-price {
      font-size: 8.2px;
      font-weight: 900;
      color: var(--teal-dark);
    }
    .audit-opt-card.featured .audit-opt-price {
      color: #15803d;
    }
    .audit-opt-desc {
      font-size: 6.4px;
      color: var(--slate-600);
      line-height: 1.16;
    }

    /* CAJA DE REGALO BÓVEDA */
    .gift-box {
      background: #fffbeb;
      border: 1.4px dashed #d97706;
      border-radius: 4.5px;
      padding: 3.5px 7px;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 2.5px;
    }

    /* FILAS SATÉLITES */
    .satellites-stack {
      display: flex;
      flex-direction: column;
      gap: 2.5px;
      margin-bottom: 2.2px;
      width: 100%;
    }
    .satellite-row {
      border-radius: 4px;
      padding: 3px 6.5px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }
    .satellite-row.insta {
      border: 1.1px solid #f472b6;
      background: linear-gradient(135deg, #ffffff 0%, #fdf2f8 100%);
    }
    .satellite-row.track {
      border: 1.1px solid #7dd3fc;
      background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
    }
    .satellite-row.b2b {
      border: 1.1px solid #c4b5fd;
      background: linear-gradient(135deg, #ffffff 0%, #faf5ff 100%);
    }
    .sat-left { flex: 1; min-width: 0; }
    .sat-row-header {
      display: flex;
      align-items: baseline;
      gap: 5px;
      margin-bottom: 1px;
    }
    .sat-row-title {
      font-size: 7.8px;
      font-weight: 900;
      line-height: 1.12;
      white-space: nowrap;
    }
    .sat-row-tag {
      font-size: 6px;
      font-weight: 700;
      color: var(--slate-600);
      text-transform: uppercase;
    }
    .sat-row-desc {
      font-size: 6.6px;
      color: var(--slate-700);
      line-height: 1.16;
    }
    .sat-right {
      flex-shrink: 0;
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
      gap: 1px;
      padding-left: 6px;
      border-left: 1px dashed rgba(0, 0, 0, 0.15);
    }
    .sat-suelto-info {
      font-size: 6.2px;
      color: var(--slate-600);
      white-space: nowrap;
    }
    .sat-combo-info {
      display: flex;
      align-items: center;
      gap: 3px;
    }
    .sat-combo-pill {
      font-size: 6.1px;
      font-weight: 800;
      padding: 1px 4px;
      border-radius: 3px;
      white-space: nowrap;
    }

    /* MODALIDADES Y TABLA MAESTRA CARA B TARIFAS */
    .modalities-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7px;
      margin-bottom: 3px;
    }
    .modality-col {
      border: 1.2px solid #94a3b8;
      border-radius: 4.5px;
      padding: 4.5px 7px;
      background: var(--slate-50);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .modality-col.best { border: 1.2px solid var(--plan-quatro); background: #faf5ff; }
    .modality-tag {
      font-size: 6.5px; 
      font-weight: 800;
      text-transform: uppercase;
      padding: 1px 5px;
      border-radius: 3px;
      margin: 0 auto 2px auto; 
      display: block;
      width: fit-content;
    }
    .tag-free { background: #cbd5e1; color: #1e293b; border: 1px solid #94a3b8; }
    .tag-best { background: #ddd6fe; color: #3730a3; border: 1px solid #8b5cf6; }
    .modality-title {
      font-size: 9.4px;
      font-weight: 900;
      color: var(--primary);
      text-align: center;
    }
    .modality-sub {
      font-size: 7px;
      color: var(--slate-600);
      font-style: italic;
      margin-bottom: 2.5px;
      text-align: center;
    }
    .modality-bullets {
      list-style: none;
      font-size: 7.2px;
      color: var(--slate-800);
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .modality-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 3.5px;
      line-height: 1.15;
    }
    .modality-bullets li svg {
      width: 9px;
      height: 9px;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .master-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 7.2px;
      margin-bottom: 2.5px;
    }
    .master-table th {
      background: var(--primary-dark);
      color: white;
      font-size: 6.6px;
      font-weight: 800;
      text-transform: uppercase;
      padding: 2.8px 2px;
      border: 1px solid #1e293b;
      text-align: center; 
      line-height: 1.12;
    }
    .master-table th .th-sub {
      display: block;
      font-size: 5.6px;
      font-weight: 600;
      color: #cbd5e1;
      margin-top: 0.5px;
    }
    .th-col1 { background: #57534e !important; }
    .th-cuota { background: #1e293b !important; }
    .th-setup { background: #334155 !important; }
    .th-via1 { background: #475569 !important; }
    .th-via2 { background: #4338ca !important; }

    .master-table td {
      padding: 2.1px 2.5px;
      border: 1px solid var(--slate-200);
      text-align: center;
      color: var(--slate-800);
      vertical-align: middle;
      line-height: 1.1;
      white-space: nowrap;
    }
    .master-table td.left {
      text-align: left;
      font-weight: 800;
      color: var(--primary); 
      padding-left: 4px;
    }
    .master-table tr.star-row { background: #f0fdf4; }
    .master-table tr.star-row td { border: 1px solid #86efac; font-weight: 700; }
    .master-table tr.corp-row { background: #ecfeff; }
    .master-table tr.corp-row td { border: 1px solid #67e8f9; font-weight: 700; }
    .master-table tr.insta-row { background: #fdf2f8; }
    .master-table tr.insta-row td { border: 1px solid #f9a8d4; font-weight: 600; }
    .master-table tr.insta-row-sep td { border-top: 1.8px solid #be185d !important; }
    .master-table tr.audit-row { background: #f0fdfa; }
    .master-table tr.audit-row td { border: 1px solid #99f6e4; font-weight: 700; }
    .master-table tr.audit-row-sep td { border-top: 1.8px solid var(--teal) !important; }

    .tag-day1 { font-weight: 800; color: var(--slate-800); font-size: 8px; }
    .tag-annual { font-weight: 900; color: #4338ca; font-size: 7.9px; display: block; }
    .tag-ahorro { font-size: 6px; color: #16a34a; font-weight: 800; display: block; }

    .extras-box {
      border: 1px solid var(--slate-200);
      background: #f8fafc;
      border-radius: 4px;
      padding: 3.5px 6px;
      margin-bottom: 2px;
    }

    .rule-box-lines {
      border: 1.2px solid var(--slate-200);
      background: #f8fafc;
      border-radius: 4.5px;
      padding: 3.2px 6.5px;
      margin-bottom: 2px;
    }
    .rule-title {
      font-size: 7px;
      font-weight: 900;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.2px;
      margin-bottom: 1.5px;
      display: block;
    }
    .rule-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.4px;
      font-size: 6.5px;
      color: var(--slate-700);
      line-height: 1.16;
    }
    .rule-list li {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }
    .rule-list li .bullet {
      color: var(--teal);
      font-weight: 900;
      font-size: 7.2px;
      line-height: 1;
      flex-shrink: 0;
    }

    /* ESTILOS TARJETÓN LANZAMIENTO Y CATÁLOGO FASE 1 (MÁS AIRE Y LETRA MÁS GRANDE) */
    .card-product {
      width: 100%;
      background: var(--slate-50);
      border: 1.4px solid var(--slate-200);
      border-radius: 5px;
      padding: 5px 8.5px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      margin-bottom: 4px;
    }
    .card-product.green-style {
      background: #f0fdfa;
