      });
    }

    /* ========================================================================= */
    /* LOGICA DEL REPRODUCTOR DE AUDIO Y WEB AUDIO API (Ecualizador Dinámico)    */
    /* ========================================================================= */
    let flotanteOcultoUsuario = false;
    let audioCtx = null;
    let analyser = null;
    let sourceNode = null;
    let dataArray = null;
    let eqAnimationId = null;

    function initWebAudio() {
      const audioEl = document.getElementById('audioEpisodio1');
      if (!audioEl) return;
      
      try {
        if (!audioCtx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContext();
          analyser = audioCtx.createAnalyser();
          analyser.fftSize = 64; 
          sourceNode = audioCtx.createMediaElementSource(audioEl);
          sourceNode.connect(analyser);
          analyser.connect(audioCtx.destination);
          dataArray = new Uint8Array(analyser.frequencyBinCount);
          
          document.querySelectorAll('.eq-bar').forEach(bar => {
             bar.style.animation = 'none';
          });
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
      } catch (e) {
        console.log("Web Audio API no soportada o bloqueada por CORS. Se usará el ecualizador por defecto.", e);
      }
    }

    function renderEQ() {
      const audioEl = document.getElementById('audioEpisodio1');
      if (!analyser || !audioEl || audioEl.paused) return;
      
      eqAnimationId = requestAnimationFrame(renderEQ);
      analyser.getByteFrequencyData(dataArray);

      const getAvg = (start, end) => {
        let sum = 0;
        for(let i = start; i < end; i++) sum += dataArray[i];
        return sum / (end - start);
      };

      const val1 = Math.max(15, (getAvg(0, 3) / 255) * 100);
      const val2 = Math.max(15, (getAvg(3, 7) / 255) * 100);
      const val3 = Math.max(15, (getAvg(7, 15) / 255) * 100);
      const val4 = Math.max(15, (getAvg(15, 31) / 255) * 100);

      const applyHeights = (parentId) => {
        const parent = document.getElementById(parentId);
        if(parent && !parent.classList.contains('hidden')) {
           const bars = parent.querySelectorAll('.eq-bar');
           if(bars[0]) bars[0].style.height = val1 + '%';
           if(bars[1]) bars[1].style.height = val2 + '%';
           if(bars[2]) bars[2].style.height = val3 + '%';
           if(bars[3]) bars[3].style.height = val4 + '%';
        }
      };

      applyHeights('eqMain');
      applyHeights('eqFlotante');
    }

    function formatTime(seconds) {
      if (isNaN(seconds)) return "0:00";
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return m + ":" + (s < 10 ? "0" : "") + s;
    }

    function syncAudioUI() {
      const audio = document.getElementById('audioEpisodio1');
      const timeCurrent = document.getElementById('timeCurrent');
      const progressMain = document.getElementById('progressMain');
      if (!audio || !timeCurrent || !progressMain) return;
      
      if (audio.duration && !isNaN(audio.duration)) {
         document.getElementById('timeTotal').textContent = formatTime(audio.duration);
         progressMain.value = (audio.currentTime / audio.duration) * 100;
      }
      timeCurrent.textContent = formatTime(audio.currentTime);
    }

    function seekAudio(val) {
      const audio = document.getElementById('audioEpisodio1');
      if(audio && audio.duration) {
         audio.currentTime = (val / 100) * audio.duration;
      }
    }

    function changeVolume(val) {
      const audio = document.getElementById('audioEpisodio1');
      if(audio) audio.volume = val;
      if(document.getElementById('volMain')) document.getElementById('volMain').value = val;
      if(document.getElementById('volFlotante')) document.getElementById('volFlotante').value = val;
    }

