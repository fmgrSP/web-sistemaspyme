    async function abrirArticuloMagazine(e, defaultHref) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
      if (window.location.protocol === 'file:') return;
      e.preventDefault();

      if (window.history.replaceState) {
        window.history.replaceState(null, null, '#magazine');
      }

      const rutasCandidatas = [
        defaultHref,
        'Pyme_Magazine_N1.html',
        '/articulos/Pyme_Magazine_N1.html',
        '/Pyme_Magazine_N1.html'
      ];
      for (const ruta of rutasCandidatas) {
        try {
          const resp = await fetch(ruta, { method: 'HEAD', cache: 'no-store' });
          if (resp.ok) {
            window.location.href = ruta;
            return;
          }
        } catch (err) {}
      }
      window.location.href = defaultHref;
    }

    function renderizarQrCorporativoSP(imgEl) {
      if (!imgEl || imgEl.dataset.qrRendered === "1") return;
      imgEl.dataset.qrRendered = "1";
      const url = imgEl.getAttribute("data-qr-url") || "https://sistemaspyme.es";
      const theme = imgEl.getAttribute("data-qr-theme") || "light";
      const esOscuro = theme === "dark";

      if (typeof QRCodeStyling === "undefined") {
        imgEl.src = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&color=0d7d74&data=" + encodeURIComponent(url);
        return;
      }

      const qr = new QRCodeStyling({
        width: 320,
        height: 320,
        type: "canvas",
        data: url,
        margin: 6,
        qrOptions: { errorCorrectionLevel: "H" },
        image: esOscuro ? SVG_LOGO_SP_BLANCO : SVG_LOGO_SP_OSCURO,
        dotsOptions: {
          type: "classy-rounded",
          gradient: {
            type: "linear",
            rotation: Math.PI / 4,
            colorStops: esOscuro
              ? [{ offset: 0, color: "#00d896" }, { offset: 1, color: "#14b8a6" }]
              : [{ offset: 0, color: "#00c48c" }, { offset: 1, color: "#0b6460" }]
          }
        },
        cornersSquareOptions: {
