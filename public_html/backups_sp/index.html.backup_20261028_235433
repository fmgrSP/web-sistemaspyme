       const miniPlayer = document.getElementById('miniPlayerFlotante');
       if(miniPlayer) {
          miniPlayer.classList.add('translate-y-[150%]', 'opacity-0');
          miniPlayer.classList.remove('translate-y-0', 'opacity-100');
       }
    }

    function scrollToPlayer() {
      const p = document.getElementById('centroMultimediaMagazine');
      if (p) p.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function checkMiniPlayer() {
      const audioEl = document.getElementById('audioEpisodio1');
      const miniPlayer = document.getElementById('miniPlayerFlotante');
      const mainPlayerCont = document.getElementById('centroMultimediaMagazine');

      if (!audioEl || !miniPlayer || !mainPlayerCont) return;

      const rect = mainPlayerCont.getBoundingClientRect();
      const isMainOutOfView = rect.bottom < 0 || rect.top > window.innerHeight;

      const iconPlayMain = document.getElementById('iconPlayMain');
      const iconPauseMain = document.getElementById('iconPauseMain');
      const eqMain = document.getElementById('eqMain');
      const eqMainIdle = document.getElementById('eqMainIdle');
      
      const iconPlayFlotante = document.getElementById('iconPlayFlotante');
      const iconPauseFlotante = document.getElementById('iconPauseFlotante');

      if (audioEl.paused) {
         if(iconPlayMain) iconPlayMain.classList.remove('hidden');
         if(iconPauseMain) iconPauseMain.classList.add('hidden');
         if(eqMain) eqMain.classList.add('hidden');
         if(eqMainIdle) eqMainIdle.classList.remove('hidden');
         
         if(iconPlayFlotante) iconPlayFlotante.classList.remove('hidden');
         if(iconPauseFlotante) iconPauseFlotante.classList.add('hidden');
      } else {
         if(iconPlayMain) iconPlayMain.classList.add('hidden');
         if(iconPauseMain) iconPauseMain.classList.remove('hidden');
         if(eqMain) eqMain.classList.remove('hidden');
         if(eqMainIdle) eqMainIdle.classList.add('hidden');
         
         if(iconPlayFlotante) iconPlayFlotante.classList.add('hidden');
         if(iconPauseFlotante) iconPauseFlotante.classList.remove('hidden');
      }

      if (isMainOutOfView && !flotanteOcultoUsuario && (audioEl.currentTime > 0)) {
         miniPlayer.classList.remove('translate-y-[150%]', 'opacity-0');
         miniPlayer.classList.add('translate-y-0', 'opacity-100');
      } else {
         miniPlayer.classList.add('translate-y-[150%]', 'opacity-0');
         miniPlayer.classList.remove('translate-y-0', 'opacity-100');
      }
    }

    function inicializarAudioEventos() {
      const audio = document.getElementById('audioEpisodio1');
      if(!audio) return;
      audio.addEventListener('play', () => {
         initWebAudio();
         if(eqAnimationId) cancelAnimationFrame(eqAnimationId);
         renderEQ();
         checkMiniPlayer();
      });
      audio.addEventListener('pause', () => {
         if(eqAnimationId) cancelAnimationFrame(eqAnimationId);
         checkMiniPlayer();
      });
      audio.addEventListener('timeupdate', syncAudioUI);
      audio.addEventListener('loadedmetadata', syncAudioUI);
      
      window.addEventListener('scroll', checkMiniPlayer);
      window.addEventListener('resize', checkMiniPlayer);
    }

    window.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("img[data-qr-url]").forEach((img) => {
        if (img.getAttribute("data-qr-theme") === "dark" || (img.complete && img.naturalWidth === 0)) {
          renderizarQrCorporativoSP(img);
        }
      });
      inicializarAudioEventos();

      if (window.location.hash === '#play-podcast') {
        setTimeout(() => {
          const contenedor = document.getElementById('centroMultimediaMagazine');
          if (contenedor) {
            cambiarMedioMagazine('audio');
            contenedor.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const audio = document.getElementById('audioEpisodio1');
            if (audio) {
              initWebAudio();
              audio.play().catch(() => {});
            }
          }
        }, 300);
      }
    });

    function cargarSiguienteExtension(img) {
      if (!img) return;
      const bases = (img.getAttribute('data-img-base') || 'imagen').split(',');
      const extensiones = ['jpg', 'jpeg', 'png', 'webp', 'svg', 'JPG', 'JPEG', 'PNG', 'WEBP'];
      let candidatos = [];
      
      bases.forEach(b => {
        const baseLimpia = b.trim();
        if (!baseLimpia) return;
        
        const nfc = baseLimpia.normalize ? baseLimpia.normalize('NFC') : baseLimpia;
        const nfd = baseLimpia.normalize ? baseLimpia.normalize('NFD') : baseLimpia;
        const formas = (nfc === nfd) ? [nfc] : [nfc, nfd];

        formas.forEach(forma => {
          extensiones.forEach(ext => {
            const ruta = `${forma}.${ext}`;
            if (!candidatos.includes(ruta)) candidatos.push(ruta);
            const rutaCodificada = encodeURI(ruta);
            if (!candidatos.includes(rutaCodificada)) candidatos.push(rutaCodificada);
          });
        });
      });

      let idx = parseInt(img.getAttribute('data-try-idx') || '0', 10);
      const currentSrc = img.getAttribute('src') || '';
      
      while (idx < candidatos.length && (candidatos[idx] === currentSrc || encodeURI(candidatos[idx]) === currentSrc)) {
        idx++;
      }

      if (idx < candidatos.length) {
        img.setAttribute('data-try-idx', (idx + 1).toString());
        img.src = candidatos[idx];
      } else {
        img.onerror = null;
        if (img.id === 'imgLogoFooter' && typeof SVG_LOGO_SP_NEON !== 'undefined') {
          img.src = SVG_LOGO_SP_NEON;
        } else if (img.id === 'imgLogoMobileMenu' && typeof SVG_LOGO_DUOTONO_COMPLETO !== 'undefined') {
          img.src = SVG_LOGO_DUOTONO_COMPLETO;
        } else {
          img.src = img.getAttribute('data-img-fallback') || 'https://placehold.co/150x150/0b2545/ffffff?text=SP';
        }
      }
    }

    function cambiarMedioMagazine(medio) {
      const boxAudio = document.getElementById('mediaBoxAudio');
      const boxVideo = document.getElementById('mediaBoxVideo');
      const btnAudio = document.getElementById('tabBtnAudio');
      const btnVideo = document.getElementById('tabBtnVideo');
      const audioEl = document.getElementById('audioEpisodio1');
      const videoIframe = document.getElementById('videoIframe');

      if (medio === 'video') {
        if (audioEl) audioEl.pause();
        boxAudio.classList.add('hidden');
        boxVideo.classList.remove('hidden');
        btnVideo.className = "inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-black bg-gradient-to-r from-purple-600 via-fuchsia-600 to-indigo-600 text-white shadow-xl shadow-purple-900/60 border-2 border-purple-300 ring-2 ring-purple-400/40 transition-all group";
        btnAudio.className = "inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-teal-950/80 hover:bg-teal-900 text-teal-200 hover:text-white border-2 border-teal-500/50 shadow-md transition-all";
      } else {
        if (videoIframe) {
          const currentSrc = videoIframe.src;
          videoIframe.src = currentSrc;
        }
        boxVideo.classList.add('hidden');
        boxAudio.classList.remove('hidden');
        btnAudio.className = "inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-black bg-gradient-to-r from-teal-600 to-emerald-600 text-white shadow-lg shadow-teal-950/60 border-2 border-teal-300 transition-all";
        btnVideo.className = "inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold bg-purple-950/90 hover:bg-purple-900 text-purple-200 hover:text-white border-2 border-purple-500/60 shadow-md shadow-purple-950/50 hover:shadow-purple-900/60 transition-all group";
      }
    }

    function activarPodcastConScroll() {
      cambiarMedioMagazine('audio');
      const contenedor = document.getElementById('centroMultimediaMagazine');
      if (contenedor) {
        contenedor.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      const audio = document.getElementById('audioEpisodio1');
      if (audio) {
        initWebAudio();
        audio.play().catch(() => {});
      }
    }

    function activarVideoConScroll() {
      cambiarMedioMagazine('video');
      const contenedor = document.getElementById('centroMultimediaMagazine');
      if (contenedor) {
        contenedor.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function abrirModalLegal(seccion) {
      const modal = document.getElementById('modalLegal');
      if (!modal) return;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (seccion === 'privacidad') irSeccionLegal('sec-privacidad');
      else if (seccion === 'condiciones') irSeccionLegal('sec-meta');
      else irSeccionLegal('sec-aviso');
    }

    function cerrarModalLegal() {
      const modal = document.getElementById('modalLegal');
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function irSeccionLegal(idElemento) {
      const el = document.getElementId ? document.getElementById(idElemento) : document.getElementById(idElemento);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarModalLegal();
    });

    // CONTROLADOR EXACTO DE SCROLL PARA ANCLAS DEL MENÚ
    // Alinea el borde superior de cada sección principal exactamente al ras de la cabecera fija,
    // ocultando al 100% cualquier resto de la categoría anterior.
    function irASeccionConOffset(hash, suave = true) {
      if (!hash || !hash.startsWith('#') || hash === '#') return false;
      const destino = document.querySelector(hash);
      if (!destino) return false;

      const header = document.querySelector('header');
      const alturaHeader = header ? header.offsetHeight : 96;

      let posicionFinal = 0;
      if (hash === '#auditoria-geo' || hash === '#atril-nfc') {
        const tarjeta = (hash === '#auditoria-geo') ? (destino.firstElementChild || destino) : destino;
        const rect = tarjeta.getBoundingClientRect();
        posicionFinal = Math.max(0, rect.top + window.pageYOffset - alturaHeader - 18);
      } else {
        const rect = destino.getBoundingClientRect();
        // Parada exacta en la línea divisoria (border-t) de la sección (+1px para ocultar la sección previa por completo)
        posicionFinal = Math.max(0, rect.top + window.pageYOffset - alturaHeader + 1);
      }

      window.scrollTo({
        top: posicionFinal,
        behavior: suave ? 'smooth' : 'auto'
      });

      if (history.pushState) {
        history.pushState(null, null, hash);
      }
      return true;
    }

    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[href^="#"]');
      if (!link) return;
      const hash = link.getAttribute('href');
      if (hash && hash.length > 1) {
        const destino = document.querySelector(hash);
        if (destino) {
          e.preventDefault();
          irASeccionConOffset(hash, true);
        }
      }
    });

    window.addEventListener('load', () => {
      if (window.location.hash && window.location.hash !== '#play-podcast') {
        setTimeout(() => {
          irASeccionConOffset(window.location.hash, false);
        }, 60);
      }
    });

    window.addEventListener('pageshow', (event) => {
      if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
        if (window.location.hash === '#magazine' || window.location.hash === '#play-podcast') {
          setTimeout(() => {
            const seccionId = window.location.hash === '#play-podcast' ? 'centroMultimediaMagazine' : 'magazine';
            const seccion = document.getElementById(seccionId);
            if (seccion) {
              seccion.scrollIntoView({ behavior: 'auto', block: 'start' });
            }
          }, 50);
        }
      }
    });
  </script>

